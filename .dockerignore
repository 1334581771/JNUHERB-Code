# Git
.git
.gitignore

# Python cache
__pycache__
*.pyc
*.pyo
*.egg-info
.eggs

# Virtual environments
venv/
.venv/
env/

# Tests & examples (not needed at runtime)
tests/
examples/

# IDE
.vscode/
.idea/

# Temp
*.tmp
*.log

# Docker
Dockerfile
.dockerignore
docker-compose.yml

# SQLite db is rebuilt inside the image (RUN python -m jnuherb.build_db);
# never copy a stale host-built db into the build context.
src/jnuherb/data/jnuherb.db
src/jnuherb/data/jnuherb.db.tmp
